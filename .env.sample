UDEMY_BEARER=Your bearer token here
# For docker compose only
COURSE_URL=Your course url here

# ---- Docker API mode (optional) ----
# Shared secret between the extension and the local API. Generate your own,
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(24))"
UD_API_TOKEN=change-me
# Concurrent container jobs (1 = one course at a time)
UD_MAX_JOBS=1
# Host folders exposed to the extension's folder picker as /library/A and
# /library/C. Point them at real drives (e.g. D:/ or D:/Courses) or leave
# the defaults to keep everything inside the repo's output folder.
UD_LIBRARY_A=./output
UD_LIBRARY_C=./output
